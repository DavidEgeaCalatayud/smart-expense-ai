{
  "expo": {
    "name": "Smart Expense AI",
    "slug": "smart-expense-ai-mobile",
    "version": "0.4.0",
    "orientation": "portrait",
    "scheme": "smartexpenseai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.davidegea.smartexpenseai",
      "versionCode": 3,
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your private financial data."
        }
      ],
      "expo-notifications",
      "./plugins/withQuickAddWidget"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
