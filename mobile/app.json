{
  "expo": {
    "name": "Smart Expense AI",
    "slug": "smart-expense-ai-mobile",
    "version": "0.4.0",
    "orientation": "portrait",
    "scheme": "smartexpenseai",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.davidegea.smartexpenseai",
      "versionCode": 3,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B4F6C"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your private financial data."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00D9D0"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071B36",
          "image": "./assets/icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "./plugins/withQuickAddWidget"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
