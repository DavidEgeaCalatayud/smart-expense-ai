{
  "expo": {
    "name": "Smart Expense AI",
    "slug": "smart-expense-ai-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "smartexpenseai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.davidegea.smartexpenseai",
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
