{
  "name": "@smart-expense-ai/mobile",
  "version": "0.4.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "dependencies:check": "expo install --check",
    "export:android": "expo export --platform android --output-dir dist-android",
    "prebuild:android": "expo prebuild --platform android --clean --no-install",
    "native:android:debug": "cd android && ./gradlew :app:assembleDebug --no-daemon",
    "check:native:android": "npm run prebuild:android && npm run native:android:debug",
    "check": "npm run dependencies:check && npm run test && npm run typecheck && npm run lint && npm run export:android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@smart-expense-ai/api-contracts": "*",
    "@smart-expense-ai/domain-types": "*",
    "expo": "~57.0.17",
    "expo-background-task": "~57.0.14",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "~57.0.2",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.17",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.18",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.14",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist-android/",
      "/android/"
    ]
  }
}
