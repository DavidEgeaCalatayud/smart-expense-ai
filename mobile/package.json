{
  "name": "@smart-expense-ai/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "dependencies:check": "expo install --check",
    "native-dependencies:check": "node -e \"const reanimated=require('react-native-reanimated/package.json').version; const worklets=require('react-native-worklets/package.json').version; if(reanimated!=='4.5.1'||worklets!=='0.10.1'){console.error('Unexpected native worklets pair',{reanimated,worklets});process.exit(1)}; console.log('Native worklets pair OK',{reanimated,worklets})\"",
    "prebuild:android:check": "expo prebuild --platform android --no-install --clean",
    "export:android": "expo export --platform android --output-dir dist-android",
    "check": "npm run dependencies:check && npm run native-dependencies:check && npm run test && npm run typecheck && npm run lint && npm run prebuild:android:check && npm run export:android"
  },
  "dependencies": {
    "@smart-expense-ai/api-contracts": "*",
    "@smart-expense-ai/domain-types": "*",
    "expo": "~57.0.17",
    "expo-background-task": "~57.0.14",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.14",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist-android/"
    ]
  }
}
