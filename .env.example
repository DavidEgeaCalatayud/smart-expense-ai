# Application
APP_NAME=Smart Expense AI
APP_ENV=development
APP_DEBUG=true

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database
DATABASE_URL=postgresql+psycopg://smart_expense_user:smart_expense_password@localhost:5432/smart_expense_ai

# Authentication
# Use at least 32 random bytes. Never reuse the development placeholder in production.
JWT_SECRET=replace-with-at-least-32-random-secret-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=smart-expense-ai
JWT_AUDIENCE=smart-expense-ai-web
ACCESS_TOKEN_MINUTES=60
MOBILE_JWT_AUDIENCE=smart-expense-ai-mobile
MOBILE_ACCESS_TOKEN_MINUTES=15
MOBILE_REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_NAME=smart_expense_session
# Must be true in staging and production, where HTTPS is mandatory.
AUTH_COOKIE_SECURE=false

# Central security monitoring (backend-only)
# Required in staging/production and must use HTTPS there. Keep provider credentials out of the URL.
SECURITY_ALERT_WEBHOOK_URL=
# Optional bearer credential for the central webhook. Never expose it to frontend/mobile configuration.
SECURITY_ALERT_BEARER_TOKEN=
# Delivery is asynchronous/fail-open; these bounds prevent a monitoring outage from blocking the API.
SECURITY_ALERT_TIMEOUT_SECONDS=2
SECURITY_ALERT_QUEUE_SIZE=256

# Financial Assistant (backend-only provider configuration)
# Leave blank to keep the rest of the application operational with the assistant endpoint disabled.
OPENAI_API_KEY=
FINANCIAL_ASSISTANT_MODEL=gpt-5.6-terra
FINANCIAL_ASSISTANT_REASONING_EFFORT=low
FINANCIAL_ASSISTANT_MAX_TOOL_ROUNDS=5
FINANCIAL_ASSISTANT_MAX_TOOL_CALLS=12
FINANCIAL_ASSISTANT_MAX_OUTPUT_TOKENS=1600

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Mobile (Expo public runtime configuration; never put secrets here)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
